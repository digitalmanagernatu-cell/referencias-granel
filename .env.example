# Azure AD App Registration
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# SharePoint / Excel
SITE_ID=your_site_id_here
FILE_ID=your_file_id_here

# Server
PORT=3001

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@natulaboratories.es
# Fallback: recibe todos los emails (testing)
EMAIL_TO=digitalmanager@natuaromatic.com
# Equipo comercial (Toni, Mauro, Jaime) — reciben cuando laboratorio sube/cambia referencias
EMAIL_TO_COMERCIAL=antoniofuentes@natuaromatic.com,export4@natuaromatic.com,jaime@natuaromatic.com
# Equipo calidad (Carmen, Vanessa, Laura) — reciben cuando comercial sube refs o descarta
EMAIL_TO_CALIDAD=development2@natuaromatic.com,development@natuaromatic.com,depcalidad@natuaromatic.com

# Base de datos Neon — para detectar cambios en el Excel cada 5 min
# Obtén la connection string en: Neon Dashboard → tu proyecto → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cron secret — protege el endpoint /api/cron/check-changes de llamadas externas
CRON_SECRET=un-secreto-largo-aqui
