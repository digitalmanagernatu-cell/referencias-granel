# Azure AD App Registration
TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# SharePoint / Excel
SITE_ID=your_site_id_here
FILE_ID=your_file_id_here

# Server
PORT=3001

# Email (Resend — https://resend.com)
# 1. Crea cuenta en resend.com
# 2. Ve a Domains → Add Domain → añade natulaboratories.es → copia los registros DNS
# 3. Añade esos registros en tu panel DNS de natulaboratories.es
# 4. Genera una API Key en Resend → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@natulaboratories.es
# Destinatarios separados por coma (pruebas: solo digitalmanager)
EMAIL_TO=digitalmanager@natuaromatic.com
# Producción:
# EMAIL_TO=depcalidad@natuaromatic.com,development@natuaromatic.com,antoniofuentes@natuaromatic.com,jaime@natuaromatic.com,export4@natuaromatic.com,digitalmanager@natuaromatic.com
